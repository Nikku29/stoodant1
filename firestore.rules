rules_version = '2';

// Deny by default. Every write to these collections comes from Cloud Functions (Admin SDK, which bypasses
// these rules). The browser never reads or writes Firestore; only a signed-in admin may read leads and
// move a lead's status. See BACKEND_PLAN.md §5.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /leads/{leadId} {
      allow read: if isAdmin();
      // Contact details, consent and retention are immutable from the client; only the status moves.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'demo_scheduled', 'demo_done', 'enrolled', 'closed']
        && request.resource.data.updatedAt == request.time;

      match /notes/{noteId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['text', 'by', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time;
      }
    }

    match /consentLog/{entryId} {
      allow read: if isAdmin();
    }
  }
}

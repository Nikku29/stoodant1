rules_version = '2';

// Deny by default. Leads are written only by Cloud Functions (Admin SDK, which bypasses these rules); a
// signed-in admin may read them and move their status. See BACKEND_PLAN.md §5.
//
// Log-ins (PROGRESS_PLAN.md): the Stoodant team signs in with Google and holds the `admin` claim; teachers
// and parents sign in with their phone number. A teacher reaches only the batches whose teacherPhone is
// their number, and a parent only the progress pages whose parentPhone is theirs. Rosters, teacherPhone
// and progress are kept by Cloud Functions, never written from the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function signedIn() {
      return request.auth != null;
    }
    function phone() {
      return request.auth.token.get('phone_number', '');
    }
    function isPhone(v) {
      return v is string && v.matches('^[+]91[6-9][0-9]{9}$');
    }
    function isDay(v) {
      return v is string && v.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$');
    }
    function shortText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function batch(id) {
      return get(/databases/$(database)/documents/batches/$(id)).data;
    }
    function teachesBatch(id) {
      return signedIn() && phone() != '' && exists(/databases/$(database)/documents/batches/$(id))
        && batch(id).teacherPhone == phone() && batch(id).get('active', true) == true;
    }
    // A parent of a child in the batch. `batchAccess/{batchId}` is kept by Cloud Functions from the roster.
    function parentOfBatch(id) {
      return signedIn() && phone() != '' && exists(/databases/$(database)/documents/batchAccess/$(id))
        && get(/databases/$(database)/documents/batchAccess/$(id)).data.parentPhones.hasAny([phone()]);
    }
    // Names compare without case or extra spaces: "Aarav  Sharma" and "aarav sharma" are the same name.
    // `nameKey` holds this form so lists sort the same way everywhere and a name search can use an index.
    function normName(v) {
      return v.trim().lower().replace('\\s+', ' ');
    }
    function fresh(d) {
      return resource == null ? d.createdAt == request.time : !changed().hasAny(['createdAt']);
    }

    // ---- Unique keys (one document per value that must not repeat) ----
    // Firestore has no UNIQUE constraint, so a value that must be unique gets its own document, whose id is
    // a hash of that value. Creating a record and its key happen in one batched write: if the key already
    // belongs to another record, the create of the key fails and so does the whole write.
    //   teachers: one teacher per mobile number (it is what they log in with)
    //   students: one child per parent's number + name (two children may share a name; a sibling may not
    //             be entered twice). Each record's own id stays its auto id, which is what everything
    //             else points at.
    function teacherKey(t) {
      return hashing.sha256('teacher|' + t.phone).toHexString().lower();
    }
    function studentKey(s) {
      return hashing.sha256('student|' + s.parentPhone + '|' + normName(s.name)).toHexString().lower();
    }
    function keyPath(key) {
      return /databases/$(database)/documents/uniqueKeys/$(key);
    }
    // After this write, `key` is held by this record.
    function holds(key, kind, id) {
      return getAfter(keyPath(key)).data == {'kind': kind, 'id': id};
    }
    // After this write, this record no longer holds the key it used to have.
    function released(key, id) {
      return !existsAfter(keyPath(key)) || getAfter(keyPath(key)).data.id != id;
    }

    // A teacher fixes a mistake within two days; after that only the team can change a record.
    function recent() {
      return resource.data.createdAt > request.time - duration.value(48, 'h');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Set up by the team on /admin ----

    // Google addresses that may open /admin, one document per address (id = the address, lower case).
    // The owners in ADMIN_EMAILS always have access on top of these. Nobody can remove themselves.
    match /team/{email} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && email.matches('^[a-z0-9._%+-]+@[a-z0-9-]+([.][a-z0-9-]+)*[.][a-z]{2,}$')
        && request.resource.data.keys().hasOnly(['addedBy', 'createdAt'])
        && request.resource.data.addedBy == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() && email != request.auth.token.get('email', '');
    }

    match /teachers/{teacherId} {
      allow read: if isAdmin() || (signedIn() && phone() != '' && resource.data.phone == phone());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'nameKey', 'phone', 'subjects', 'active', 'createdAt', 'updatedAt'])
        && shortText(request.resource.data.name, 80)
        && request.resource.data.nameKey == normName(request.resource.data.name)
        && isPhone(request.resource.data.phone)
        && request.resource.data.subjects is list && request.resource.data.subjects.size() <= 10
        && request.resource.data.active is bool
        && fresh(request.resource.data)
        && request.resource.data.updatedAt == request.time
        // Same number as before, or the new number's key moves to this teacher in the same write.
        && ((resource != null && request.resource.data.phone == resource.data.phone)
            || (holds(teacherKey(request.resource.data), 'teachers', teacherId)
                && (resource == null || released(teacherKey(resource.data), teacherId))));
      allow delete: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if isAdmin() || (signedIn() && phone() != '' && resource.data.teacherPhone == phone());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'classLevel', 'board', 'subject', 'teacherId', 'schedule',
             'durationMinutes', 'active', 'createdAt', 'updatedAt', 'teacherPhone', 'teacherName', 'roster', 'studentIds'])
        && (resource == null
            ? !request.resource.data.keys().hasAny(['teacherPhone', 'teacherName', 'roster', 'studentIds'])
            : !changed().hasAny(['teacherPhone', 'teacherName', 'roster', 'studentIds']))
        && shortText(request.resource.data.name, 80)
        && request.resource.data.classLevel in ['4', '5', '6', '7', '8', '9', '10']
        && request.resource.data.board in ['CBSE', 'ICSE']
        && shortText(request.resource.data.subject, 40)
        // No teacher yet (''), or a teacher who exists.
        && request.resource.data.teacherId is string
        && (request.resource.data.teacherId == ''
            || exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)))
        && request.resource.data.schedule is string && request.resource.data.schedule.size() <= 120
        && (!('durationMinutes' in request.resource.data)
            || (request.resource.data.durationMinutes is int
                && request.resource.data.durationMinutes >= 15 && request.resource.data.durationMinutes <= 300))
        && request.resource.data.active is bool
        && fresh(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Parents' names and numbers: the team only. Teachers see children's names through batch rosters.
    match /students/{studentId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'nameKey', 'classLevel', 'board', 'parentName', 'parentPhone',
             'batchIds', 'whatsappOptIn', 'active', 'createdAt', 'updatedAt'])
        && shortText(request.resource.data.name, 80)
        && request.resource.data.nameKey == normName(request.resource.data.name)
        && request.resource.data.classLevel in ['4', '5', '6', '7', '8', '9', '10']
        && request.resource.data.board in ['CBSE', 'ICSE']
        && shortText(request.resource.data.parentName, 80)
        && isPhone(request.resource.data.parentPhone)
        // Each batch at most once. /admin only offers batches that exist, and deleting a batch takes it
        // off every child's list (onBatchWritten); rules can't check a whole list, as they may only look
        // up 10 documents per write.
        && request.resource.data.batchIds is list && request.resource.data.batchIds.size() <= 10
        && request.resource.data.batchIds.toSet().size() == request.resource.data.batchIds.size()
        && request.resource.data.whatsappOptIn is bool
        && request.resource.data.active is bool
        && fresh(request.resource.data)
        && request.resource.data.updatedAt == request.time
        // Same parent's number and name as before, or the new pair's key moves to this child.
        && ((resource != null && request.resource.data.parentPhone == resource.data.parentPhone
             && normName(request.resource.data.name) == normName(resource.data.name))
            || (holds(studentKey(request.resource.data), 'students', studentId)
                && (resource == null || released(studentKey(resource.data), studentId))));
    }

    // id = teacherKey() or studentKey(). The team creates a key together with its record and removes it
    // when the record goes or its value changes; a key never moves straight from one record to another.
    match /uniqueKeys/{key} {
      function recordPath(d) {
        return /databases/$(database)/documents/$(d.kind)/$(d.id);
      }
      function recordAfter(d) {
        return getAfter(recordPath(d));
      }
      function keyOf(d, record) {
        return d.kind == 'teachers' ? teacherKey(record.data) : studentKey(record.data);
      }
      allow get: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind', 'id'])
        && request.resource.data.kind in ['teachers', 'students']
        && request.resource.data.id is string
        && existsAfter(recordPath(request.resource.data))
        && keyOf(request.resource.data, recordAfter(request.resource.data)) == key;
      allow delete: if isAdmin()
        && (!existsAfter(recordPath(resource.data)) || keyOf(resource.data, recordAfter(resource.data)) != key);
    }

    // ---- Entered by teachers on /teacher ----

    // One per batch per class day, id `{batchId}_{date}`. `attendance` maps student id to a mark.
    match /sessions/{sessionId} {
      function validSession() {
        let d = request.resource.data;
        return d.keys().hasOnly(['batchId', 'subject', 'date', 'status', 'attendance', 'markedBy', 'createdAt', 'updatedAt'])
          && sessionId == d.batchId + '_' + d.date
          && isDay(d.date)
          && d.subject == batch(d.batchId).subject
          && d.status in ['held', 'cancelled']
          && d.attendance is map
          && d.attendance.keys().hasOnly(batch(d.batchId).get('studentIds', []))
          && d.markedBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      // A single read goes by the id, so a teacher can check whether today is marked before it exists.
      allow get: if isAdmin() || teachesBatch(sessionId.split('_')[0]);
      allow list: if isAdmin() || teachesBatch(resource.data.batchId);
      allow create: if (isAdmin() || teachesBatch(request.resource.data.batchId))
        && validSession() && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() || (teachesBatch(resource.data.batchId) && recent()))
        && validSession() && !changed().hasAny(['batchId', 'date', 'createdAt']);
      allow delete: if isAdmin();
    }

    // A test. `scores` maps student id to marks, or null when the child missed it.
    match /assessments/{assessmentId} {
      function validAssessment() {
        let d = request.resource.data;
        return d.keys().hasOnly(['batchId', 'subject', 'title', 'date', 'max', 'scores', 'enteredBy', 'createdAt', 'updatedAt'])
          && isDay(d.date)
          && d.subject == batch(d.batchId).subject
          && shortText(d.title, 60)
          && d.max is number && d.max > 0 && d.max <= 500
          && d.scores is map && d.scores.size() > 0
          && d.scores.keys().hasOnly(batch(d.batchId).get('studentIds', []))
          && d.enteredBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      allow read: if isAdmin() || teachesBatch(resource.data.batchId);
      allow create: if (isAdmin() || teachesBatch(request.resource.data.batchId))
        && validAssessment() && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() || (teachesBatch(resource.data.batchId) && recent()))
        && validAssessment() && !changed().hasAny(['batchId', 'createdAt']);
      allow delete: if isAdmin() || (teachesBatch(resource.data.batchId) && recent());
    }

    // Up to three short lines about one child, shown on the parent's page and in the weekly report.
    match /notes/{noteId} {
      function validNote() {
        let d = request.resource.data;
        return d.keys().hasOnly(['batchId', 'studentId', 'subject', 'lines', 'teacherName', 'date', 'by', 'createdAt', 'updatedAt'])
          && isDay(d.date)
          && d.studentId in batch(d.batchId).get('studentIds', [])
          && d.subject == batch(d.batchId).subject
          && d.teacherName == batch(d.batchId).teacherName
          && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 3
          && d.by == request.auth.uid
          && d.updatedAt == request.time;
      }
      allow read: if isAdmin() || teachesBatch(resource.data.batchId);
      allow create: if (isAdmin() || teachesBatch(request.resource.data.batchId))
        && validNote() && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() || (teachesBatch(resource.data.batchId) && recent()))
        && validNote() && !changed().hasAny(['batchId', 'studentId', 'createdAt']);
      allow delete: if isAdmin() || (teachesBatch(resource.data.batchId) && recent());
    }

    // Study material a teacher shares with a batch: a file in Storage (materials/{batchId}/...) or a link.
    // The batch's teacher and the team add and remove it; parents of children in the batch read it.
    match /materials/{materialId} {
      function validMaterial() {
        let d = request.resource.data;
        return d.keys().hasOnly(['batchId', 'title', 'kind', 'description', 'link', 'file', 'teacherName', 'createdBy', 'createdAt'])
          && exists(/databases/$(database)/documents/batches/$(d.batchId))
          && shortText(d.title, 100)
          && d.kind in ['notes', 'pyq', 'homework', 'worksheet', 'other']
          && (!('description' in d) || (d.description is string && d.description.size() <= 300))
          && (('link' in d) != ('file' in d))
          && (!('link' in d) || (d.link is string && d.link.size() <= 500 && d.link.matches('^https://.+')))
          && (!('file' in d) || (d.file is map
              && d.file.keys().hasOnly(['path', 'name', 'size', 'type'])
              && d.file.path is string && d.file.path.matches('^materials/' + d.batchId + '/[^/]+/[^/]+$')
              && shortText(d.file.name, 200)
              && d.file.size is int && d.file.size > 0 && d.file.size <= 20 * 1024 * 1024
              && d.file.type is string))
          && d.teacherName is string && d.teacherName.size() <= 80
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }
      allow read: if isAdmin() || teachesBatch(resource.data.batchId) || parentOfBatch(resource.data.batchId);
      allow create: if (isAdmin() || teachesBatch(request.resource.data.batchId)) && validMaterial();
      allow delete: if isAdmin() || teachesBatch(resource.data.batchId);
    }

    // ---- Read by parents on /parent (written only by Cloud Functions) ----

    match /progress/{studentId} {
      allow read: if isAdmin() || (signedIn() && phone() != '' && resource.data.parentPhone == phone());
    }

    // ---- Demo requests ----

    match /leads/{leadId} {
      allow read: if isAdmin();
      // Contact details, consent and retention are immutable from the client; only the status moves.
      // The team can delete a request (spam, duplicates). The consent record stays in consentLog.
      allow delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'demo_scheduled', 'demo_done', 'enrolled', 'closed']
        && request.resource.data.updatedAt == request.time;

      match /notes/{noteId} {
        allow read, delete: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['text', 'by', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time;
      }
    }

    match /consentLog/{entryId} {
      allow read: if isAdmin();
    }
  }
}

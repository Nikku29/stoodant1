rules_version = '2';

// Deny by default. Leads are written only by Cloud Functions (Admin SDK, which bypasses these rules); a
// signed-in admin may read them and move their status. See BACKEND_PLAN.md §5.
//
// Log-ins (PROGRESS_PLAN.md): the Stoodant team signs in with Google and holds the `admin` claim; teachers
// and parents sign in with their phone number. A teacher reaches only the batches whose teacherPhone is
// their number, and a parent only the progress pages whose parentPhone is theirs. Rosters, teacherPhone
// and progress are kept by Cloud Functions, never written from the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function signedIn() {
      return request.auth != null;
    }
    function phone() {
      return request.auth.token.get('phone_number', '');
    }
    function isPhone(v) {
      return v is string && v.matches('^[+]91[6-9][0-9]{9}$');
    }
    function isDay(v) {
      return v is string && v.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$');
    }
    function shortText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function batch(id) {
      return get(/databases/$(database)/documents/batches/$(id)).data;
    }
    function teachesBatch(id) {
      return signedIn() && phone() != '' && exists(/databases/$(database)/documents/batches/$(id))
        && batch(id).teacherPhone == phone() && batch(id).get('active', true) == true;
    }
    // A teacher fixes a mistake within two days; after that only the team can change a record.
    function recent() {
      return resource.data.createdAt > request.time - duration.value(48, 'h');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Set up by the team on /admin ----

    match /teachers/{teacherId} {
      allow read: if isAdmin() || (signedIn() && phone() != '' && resource.data.phone == phone());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'subjects', 'active', 'createdAt', 'updatedAt'])
        && shortText(request.resource.data.name, 80)
        && isPhone(request.resource.data.phone)
        && request.resource.data.subjects is list && request.resource.data.subjects.size() <= 10
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if isAdmin() || (signedIn() && phone() != '' && resource.data.teacherPhone == phone());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'classLevel', 'board', 'subject', 'teacherId', 'schedule',
             'active', 'createdAt', 'updatedAt', 'teacherPhone', 'teacherName', 'roster', 'studentIds'])
        && (resource == null
            ? !request.resource.data.keys().hasAny(['teacherPhone', 'teacherName', 'roster', 'studentIds'])
            : !changed().hasAny(['teacherPhone', 'teacherName', 'roster', 'studentIds']))
        && shortText(request.resource.data.name, 80)
        && request.resource.data.classLevel in ['4', '5', '6', '7', '8', '9', '10']
        && request.resource.data.board in ['CBSE', 'ICSE']
        && shortText(request.resource.data.subject, 40)
        && request.resource.data.teacherId is string
        && request.resource.data.schedule is string && request.resource.data.schedule.size() <= 120
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Parents' names and numbers: the team only. Teachers see children's names through batch rosters.
    match /students/{studentId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'classLevel', 'board', 'parentName', 'parentPhone',
             'batchIds', 'whatsappOptIn', 'active', 'createdAt', 'updatedAt'])
        && shortText(request.resource.data.name, 80)
        && request.resource.data.classLevel in ['4', '5', '6', '7', '8', '9', '10']
        && request.resource.data.board in ['CBSE', 'ICSE']
        && shortText(request.resource.data.parentName, 80)
        && isPhone(request.resource.data.parentPhone)
        && request.resource.data.batchIds is list && request.resource.data.batchIds.size() <= 10
        && request.resource.data.whatsappOptIn is bool
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
    }

    // ---- Entered by teachers on /teacher ----

    // One per batch per class day, id `{batchId}_{date}`. `attendance` maps student id to a mark.
    match /sessions/{sessionId} {
      function validSession() {
        let d = request.resource.data;
        return d.keys().hasOnly(['batchId', 'subject', 'date', 'status', 'attendance', 'markedBy', 'createdAt', 'updatedAt'])
          && sessionId == d.batchId + '_' + d.date
          && isDay(d.date)
          && d.subject == batch(d.batchId).subject
          && d.status in ['held', 'cancelled']
          && d.attendance is map
          && d.attendance.keys().hasOnly(batch(d.batchId).get('studentIds', []))
          && d.markedBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      // A single read goes by the id, so a teacher can check whether today is marked before it exists.
      allow get: if isAdmin() || teachesBatch(sessionId.split('_')[0]);
      allow list: if isAdmin() || teachesBatch(resource.data.batchId);
      allow create: if (isAdmin() || teachesBatch(request.resource.data.batchId))
        && validSession() && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() || (teachesBatch(resource.data.batchId) && recent()))
        && validSession() && !changed().hasAny(['batchId', 'date', 'createdAt']);
      allow delete: if isAdmin();
    }

    // A test. `scores` maps student id to marks, or null when the child missed it.
    match /assessments/{assessmentId} {
      function validAssessment() {
        let d = request.resource.data;
        return d.keys().hasOnly(['batchId', 'subject', 'title', 'date', 'max', 'scores', 'enteredBy', 'createdAt', 'updatedAt'])
          && isDay(d.date)
          && d.subject == batch(d.batchId).subject
          && shortText(d.title, 60)
          && d.max is number && d.max > 0 && d.max <= 500
          && d.scores is map && d.scores.size() > 0
          && d.scores.keys().hasOnly(batch(d.batchId).get('studentIds', []))
          && d.enteredBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      allow read: if isAdmin() || teachesBatch(resource.data.batchId);
      allow create: if (isAdmin() || teachesBatch(request.resource.data.batchId))
        && validAssessment() && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() || (teachesBatch(resource.data.batchId) && recent()))
        && validAssessment() && !changed().hasAny(['batchId', 'createdAt']);
      allow delete: if isAdmin() || (teachesBatch(resource.data.batchId) && recent());
    }

    // Up to three short lines about one child, shown on the parent's page and in the weekly report.
    match /notes/{noteId} {
      function validNote() {
        let d = request.resource.data;
        return d.keys().hasOnly(['batchId', 'studentId', 'subject', 'lines', 'teacherName', 'date', 'by', 'createdAt', 'updatedAt'])
          && isDay(d.date)
          && d.studentId in batch(d.batchId).get('studentIds', [])
          && d.subject == batch(d.batchId).subject
          && d.teacherName == batch(d.batchId).teacherName
          && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 3
          && d.by == request.auth.uid
          && d.updatedAt == request.time;
      }
      allow read: if isAdmin() || teachesBatch(resource.data.batchId);
      allow create: if (isAdmin() || teachesBatch(request.resource.data.batchId))
        && validNote() && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() || (teachesBatch(resource.data.batchId) && recent()))
        && validNote() && !changed().hasAny(['batchId', 'studentId', 'createdAt']);
      allow delete: if isAdmin() || (teachesBatch(resource.data.batchId) && recent());
    }

    // ---- Read by parents on /parent (written only by Cloud Functions) ----

    match /progress/{studentId} {
      allow read: if isAdmin() || (signedIn() && phone() != '' && resource.data.parentPhone == phone());
    }

    // ---- Demo requests ----

    match /leads/{leadId} {
      allow read: if isAdmin();
      // Contact details, consent and retention are immutable from the client; only the status moves.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'demo_scheduled', 'demo_done', 'enrolled', 'closed']
        && request.resource.data.updatedAt == request.time;

      match /notes/{noteId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['text', 'by', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time;
      }
    }

    match /consentLog/{entryId} {
      allow read: if isAdmin();
    }
  }
}

rules_version = '2';

// Deny by default. Teacher photos (consented) and study material for batches.
// Originals are admin-only; a function writes WebP/AVIF variants to public/ only when consent is logged.
// See BACKEND_PLAN.md §5.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /public/teachers/{slug}/{file} {
      allow read: if true;
    }

    match /originals/{kind}/{id}/{file} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && kind in ['teachers', 'media']
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
    }

    // Study material: materials/{batchId}/{materialId}/{fileName}. The batch's teacher and the team upload;
    // parents of children in the batch download (batchAccess is kept by Cloud Functions).
    // Pictures are photos only: no SVG, which can carry script.
    function teaches(batchId) {
      return request.auth != null && request.auth.token.get('phone_number', '') != ''
        && firestore.exists(/databases/(default)/documents/batches/$(batchId))
        && firestore.get(/databases/(default)/documents/batches/$(batchId)).data.get('teacherPhone', '') == request.auth.token.phone_number
        && firestore.get(/databases/(default)/documents/batches/$(batchId)).data.get('active', true) == true;
    }
    function parentOf(batchId) {
      return request.auth != null && request.auth.token.get('phone_number', '') != ''
        && firestore.exists(/databases/(default)/documents/batchAccess/$(batchId))
        && firestore.get(/databases/(default)/documents/batchAccess/$(batchId)).data.parentPhones.hasAny([request.auth.token.phone_number]);
    }
    match /materials/{batchId}/{materialId}/{fileName} {
      allow read: if isAdmin() || teaches(batchId) || parentOf(batchId);
      allow create: if (isAdmin() || teaches(batchId))
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp|gif|heic|heif)|application/msword|application/vnd[.]openxmlformats-officedocument[.].*|application/vnd[.]ms-.*|text/plain');
      allow delete: if isAdmin() || teaches(batchId);
    }

    match /private/{allPaths=**} {
      allow read: if isAdmin();
    }
    // The scholarship test's question bank (with answers): only the team uploads it, only the exam function reads it.
    match /private/exam/bank.json {
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType == 'application/json';
    }
  }
}
